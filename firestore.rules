rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/cecilia-1-aninho/photos/{photoId} {
      // Galeria pública para visualização e download.
      allow read: if true;

      // Cadastro exige autenticação anônima ou outra sessão Firebase autenticada.
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'storagePath', 'downloadURL', 'createdAt', 'contentType',
          'sizeBytes', 'photoId', 'userId', 'capturedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'storagePath', 'downloadURL', 'createdAt', 'contentType',
          'sizeBytes', 'photoId', 'userId', 'capturedAt'
        ])
        && request.resource.data.photoId == photoId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath == 'events/cecilia-1-aninho/photos/' + photoId + '.jpg'
        && request.resource.data.downloadURL is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.capturedAt is timestamp
        && request.resource.data.contentType == 'image/jpeg'
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes > 0
        && request.resource.data.sizeBytes <= 8 * 1024 * 1024;

      // Convidados não podem alterar nem excluir fotos cadastradas.
      allow update, delete: if false;
    }
  }
}